<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Neon outer stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#527C4DFF" />
        </shape>
    </item>
    <!-- Glass body -->
    <item android:top="1dp" android:bottom="1dp" android:start="1dp" android:end="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <gradient
                android:angle="270"
                android:startColor="#F7121120"
                android:centerColor="#EA0E0B18"
                android:endColor="#E6161231"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
