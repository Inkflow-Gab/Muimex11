<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gsPanel"
    android:layout_width="228dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gamespace_panel"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Detected app header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/gsAppIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="@string/gs_app_header"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/gsAppName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/gs_menu_title"
                android:textColor="#FFFFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gs_app_header"
                android:textColor="#8B93A2"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/gsFpsChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_gamespace_fps_chip"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingVertical="3dp"
            android:text="-- FPS"
            android:textColor="#9FE8AB"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/gsBtnMinimize"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_minimize"
            android:padding="4dp"
            android:src="@drawable/ic_minimize"
            android:tint="#9AA3B2" />

        <ImageView
            android:id="@+id/gsBtnKill"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_close_overlay"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            android:tint="#FF8A80" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/gsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/gsItemContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
